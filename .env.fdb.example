# LiveKit Cloud (required by FDB-v3 inference)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Official Full-Duplex-Bench checkout and data
INTERRA_FDB_V3_ROOT=.runtime/Full-Duplex-Bench/v3
INTERRA_FDB_DATA_ROOT=.runtime/Full-Duplex-Bench/v3/fdb_v3_data_released

# LiveKit Inference is the default LLM, STT, and TTS provider.
INTERRA_FDB_LLM_PROVIDER=livekit
INTERRA_FDB_LLM_MODEL=openai/gpt-4.1-mini
INTERRA_FDB_STT_MODEL=deepgram/nova-3
INTERRA_FDB_STT_FALLBACK_MODELS=assemblyai/universal-3-5-pro
INTERRA_FDB_TTS_MODEL=cartesia/sonic-3
INTERRA_FDB_TTS_FALLBACK_MODELS=deepgram/aura-2:athena
INTERRA_FDB_VOICE_ID=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
INTERRA_FDB_SESSION_COOLDOWN_SECONDS=3

# Optional local LLM fallback: set INTERRA_FDB_LLM_PROVIDER=ollama.
INTERRA_OLLAMA_MODEL=qwen3:8b
INTERRA_OLLAMA_OPENAI_URL=http://localhost:11434/v1

INTERRA_FDB_LATENCY_PROFILE=instant
# auto: commit gate only when the worker runs under a dispatch name (judge page);
# off under the official runner. on/off force either.
INTERRA_FDB_COMMIT_GATE=auto
INTERRA_FDB_TRACE_DIR=artifacts/fdb_v3
