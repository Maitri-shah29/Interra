# Copy to .env.local. Never commit the populated file.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
OPENAI_API_KEY=
# Reference path: hosted Whisper + declared OpenAI planner + hosted TTS.
# To use the existing local planner instead, set both variables below:
# INTERRA_PLANNER=ollama
# INTERRA_MODEL=gemma3:4b
# INTERRA_OLLAMA_URL=http://localhost:11434
# Full FDB evaluation still needs OPENAI_API_KEY for speech and the judge.
