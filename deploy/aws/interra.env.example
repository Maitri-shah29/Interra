# Copy to interra.env on the server (chmod 600). Never commit the copy.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Turns on /settings. 8 characters or more.
INTERRA_ADMIN_PASSWORD=
# Optional: every page asks for this password (any user name).
INTERRA_SITE_PASSWORD=
